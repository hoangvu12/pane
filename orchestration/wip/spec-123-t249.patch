+        let text = div()
+            .id("toast-details-text")
+            .debug_selector(|| "toast-details-text".into())
+            .flex_initial()
+            .min_w(px(0.))
+            .w_full()
+            .max_h(px(TEXT_MAX))
+            .overflow_y_scroll()
+            .flex()
+            .flex_col()
+            .gap(theme.geometry.footer_hint_gap)
+            .text_size(theme.typography.footer_size)
