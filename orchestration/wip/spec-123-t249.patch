+            .iter()
+            .enumerate()
+            .map(|(index, slot)| {
+                // A listed slot has its action; the slots came from it.
+                let action = details
+                    .toast
+                    .toast
+                    .action(*slot)
+                    .expect("the action of a listed slot");
+                let label = action.title.clone();
+                let shortcut = action.shortcut.as_ref().map(crate::keyboard::binding_keys);
