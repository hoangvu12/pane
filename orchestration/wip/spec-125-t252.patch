+/// How a binding's presses reach Pane (ADR 0039): through the system's
+/// own registration, or — where the system refused the registration —
+/// through Pane's own low-level keyboard hook. The Settings pages show
+/// what follows from it on the binding's row ([`HotkeyRoute::notes`]);
+/// the Keyboard page (#259) builds its view of Pane's hotkey health on
+/// the routes the launcher exposes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum HotkeyRoute {
+    /// The system's registration reports the press: `RegisterHotKey` on
+    /// Windows, Carbon on macOS, `XGrabKey` on X11.
+    Registered,
+    /// Pane's own low-level keyboard hook recognizes the binding, as on
+    /// Windows where the registration was refused (another application
+    /// or Windows itself has the chord) — a refused registration is not
+    /// an error: the binding works.
+    Hook,
+}
+
+/// What a hook-dispatched binding cannot do, as its row says: Windows
+/// does not deliver the keys an elevated application holds to the
+/// keyboard hook of a normal process, so the binding does nothing while
+/// one is in front. Static here — no elevation is detected in this
+/// slice; #259's Keyboard page and #261's game mode build on the data
+/// this constant stands in for.
+pub const HOOK_ELEVATED_LIMIT: &str =
+    "It does nothing while an application running as administrator is in front";
+
+impl HotkeyRoute {
+    /// What a row shows beside a binding dispatched this way: the route,
+    /// what the system does with the shortcut's keys where it keeps them
+    /// ([`Shortcut::system_uses`]), and the elevated-foreground limit.
+    /// Nothing for a registered binding — the ordinary case, which says
+    /// nothing of itself.
+    pub fn notes(self, shortcut: &Shortcut) -> Vec<&'static str> {
+        if self != HotkeyRoute::Hook {
+            return Vec::new();
+        }
+        let mut notes = vec!["Dispatched through Pane's keyboard hook"];
+        notes.extend(shortcut.system_uses());
+        notes.push(HOOK_ELEVATED_LIMIT);
+        notes
+    }
+}
