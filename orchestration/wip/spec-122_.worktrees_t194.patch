+/// A command whose first argument is not text cannot be sent the query,
+/// so the extension list offers no fallback row for it (#194).
+#[test]
+fn a_command_whose_first_argument_is_not_text_is_not_offered_as_a_fallback() {
+    let (pane, status) = install_changed(|manifest| {
+        manifest["commands"][0]["arguments"][0]["type"] = "password".into();
+    });
+    assert!(matches!(status, Status::Result(_)), "{status:?}");
+    manage(&pane.launcher);
+    let rows = titles(&pane.launcher);
+    assert!(
+        !rows.iter().any(|row| row == "Fallback: Greet"),
+        "Greet's first argument is a password: {rows:?}"
+    );
+    // Stamp's first argument is text and Relay takes a query, so both are
+    // offered.
+    select_title(&pane.launcher, "Fallback: Stamp");
+    select_title(&pane.launcher, "Fallback: Relay");
+}
