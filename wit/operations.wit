package pane:extension@0.1.0;

// SPDX-License-Identifier: Apache-2.0 OR MIT
//
// Calling an operation another installed package publishes. Rust commands
// import it through pane-guest, JS/TS commands as the module
// "pane:extension/operations@0.1.0" (guests/js/operations.d.ts). A package
// publishes an operation by listing it under `operations` in its pane.json;
// Pane then serves calls to it through the component's `run-operation`.

/// Calls an operation another installed package publishes, through Pane.
interface operations {
  /// Why a call did not produce the operation's result. `message` explains
  /// it for people; `kind` tells lifecycle failures from the operation's own
  /// error.
  record call-error {
    kind: call-error-kind,
    message: string,
  }

  enum call-error-kind {
    /// No installed package has that source, or it does not publish that
    /// operation.
    not-found,
    /// The package is disabled. Pane does not enable it for the call.
    disabled,
    /// The package publishes the operation at another version, or Pane
    /// cannot run its component.
    incompatible,
    /// The package cannot run here: it does not support this system, or the
    /// extension runtime is not running.
    unavailable,
    /// The operation ran and reported an error; `message` is its own.
    failed,
    /// The package crashed while serving the call. The next call starts it
    /// afresh.
    crashed,
    /// Pane refused the call: it would reach a package already serving a
    /// call in the same chain, the chain is too deep, or the input or result
    /// is not JSON within Pane's limits.
    refused,
  }

  /// Calls `operation` at `version` of the installed package with source
  /// `source`, and waits for its result. The package is started for the
  /// call if it is not running. `source` is `local:` followed by the
  /// package folder's path: absolute, as Pane shows it, or relative to the
  /// calling package's own source folder, such as `local:../other`. `input`
  /// and the result are JSON text.
  call: async func(source: string, operation: string, version: u32, input: string) -> result<string, call-error>;
}
